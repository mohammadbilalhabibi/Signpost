# Copy to .env and fill in. Never commit .env.

# --- LLM (any OpenAI-compatible API) ---
# openai | azure | mistral | ollama | groq | openrouter | ...
#   openai:  LLM_BASE_URL=https://api.openai.com/v1
#   azure:   LLM_BASE_URL=https://<resource>.openai.azure.com, LLM_MODEL=<deployment name>,
#            LLM_API_VERSION=2024-10-21
#   mistral: LLM_BASE_URL=https://api.mistral.ai/v1, LLM_MODEL=mistral-small-latest
#   ollama:  LLM_BASE_URL=http://localhost:11434/v1, LLM_MODEL=llama3.1, LLM_API_KEY empty
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# LLM_API_VERSION=2024-10-21
# Seconds per request, and retries on timeouts / connection errors / 429 / 5xx
LLM_TIMEOUT=30
LLM_MAX_RETRIES=1
# Reasoning models count hidden reasoning tokens against this limit
LLM_MAX_OUTPUT_TOKENS=2000
# Unset = provider default (some reasoning models reject a temperature)
# LLM_TEMPERATURE=0.2
# auto = max_completion_tokens for openai/azure, max_tokens for other providers
LLM_TOKEN_PARAM=auto

# --- Models ---
EMBEDDING_MODEL=intfloat/multilingual-e5-base
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# onnx = int8 ONNX export (run scripts/export_reranker.py once; ~1.5x faster than torch);
# torch = original fp32 model via sentence-transformers
RERANKER_BACKEND=onnx
# RERANKER_ONNX_DIR=models/bge-reranker-v2-m3-onnx-int8
# ONNX Runtime intra-op threads; 0 = runtime default (number of physical cores)
RERANKER_THREADS=0

# --- Retrieval ---
TOP_K_RETRIEVE=20
TOP_K_FINAL=5
# Reranker speed knobs (20/256: ~9 s reranking on a 4-core laptop CPU):
# hybrid candidates scored by the reranker
RERANK_CANDIDATES=20
# max tokens per (question, passage) pair; lower = faster, longer pairs get truncated
# (512 never truncates our <=350-token chunks but is ~1.8x slower)
RERANK_MAX_LENGTH=256
# Reciprocal Rank Fusion constant for the hybrid retriever
RRF_K=60
# Where chunks and indexes live (relative to the project root)
# Curated source collection (sources.json, text/, documents/) used by scripts/ingest.py
# COLLECTION_DIR=DIT_Arrival_RAG_English/DIT_Arrival_RAG_English
# CHUNKS_PATH=data/processed/chunks.jsonl
# INDEX_DIR=index
# Minimum best reranker score (0-1) to call the LLM; below it Signpost refuses.
# Measured on the arrival collection: off-topic questions <= 0.0031, lowest answerable 0.061.
REFUSAL_THRESHOLD=0.02
# At most this many of the TOP_K_FINAL passages from one document (0 = no cap)
MAX_CHUNKS_PER_DOC=3

# --- Web API ---
# Questions / feedback requests per client IP per minute
RATE_LIMIT_PER_MINUTE=10
FEEDBACK_RATE_LIMIT_PER_MINUTE=30
# Only behind a trusted reverse proxy (e.g. Hugging Face Spaces): use X-Forwarded-For as client IP
TRUST_FORWARDED_FOR=false
# LOGS_DIR=logs

# --- Ingestion ---
# Sent with every request. Add a contact URL or e-mail if you crawl at scale.
INGEST_USER_AGENT="SignpostIngest/0.1 (non-commercial student project; bilingual RAG assistant)"
# Minimum seconds between two requests to the same host (>= 1; robots.txt Crawl-delay wins if larger)
INGEST_REQUEST_DELAY=1.0
INGEST_TIMEOUT=30
# Chunking: max tokens per chunk (multilingual-e5 tokenizer, incl. the title prefix) and overlap share
CHUNK_TOKENS=350
CHUNK_OVERLAP=0.15
# Merge sibling sections smaller than this many tokens (default CHUNK_TOKENS/4; 0 = off)
# CHUNK_MIN_SECTION_TOKENS=87
