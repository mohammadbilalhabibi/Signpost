# Copy to .env and fill in. Never commit .env.

# --- LLM (any OpenAI-compatible API) ---
# openai | azure | mistral | ollama | groq | openrouter | ...
#   openai:  LLM_BASE_URL=https://api.openai.com/v1
#   azure:   LLM_BASE_URL=https://<resource>.openai.azure.com, LLM_MODEL=<deployment name>,
#            LLM_API_VERSION=2024-10-21
#   mistral: LLM_BASE_URL=https://api.mistral.ai/v1, LLM_MODEL=mistral-small-latest
#   ollama:  LLM_BASE_URL=http://localhost:11434/v1, LLM_MODEL=llama3.1, LLM_API_KEY empty
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# LLM_API_VERSION=2024-10-21
# Seconds per request, and retries on timeouts / connection errors / 429 / 5xx
LLM_TIMEOUT=30
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=600
# Unset = provider default (some reasoning models reject a temperature)
# LLM_TEMPERATURE=0.2
# auto = max_completion_tokens for openai/azure, max_tokens for other providers
LLM_TOKEN_PARAM=auto

# --- Models ---
EMBEDDING_MODEL=intfloat/multilingual-e5-base
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# onnx = int8 ONNX export (run scripts/export_reranker.py once; ~3x faster per query with
# TOP_K_RERANK=10); torch = original fp32 model via sentence-transformers
RERANKER_BACKEND=onnx
# RERANKER_ONNX_DIR=models/bge-reranker-v2-m3-onnx-int8
# ONNX Runtime intra-op threads; 0 = runtime default (number of physical cores)
RERANKER_THREADS=0

# --- Retrieval ---
TOP_K_RETRIEVE=20
TOP_K_FINAL=5
# Hybrid candidates scored by the reranker (main latency knob: ~0.7 s per candidate on a 4-core CPU)
TOP_K_RERANK=10
# Reciprocal Rank Fusion constant for the hybrid retriever
RRF_K=60
# Where chunks and indexes live (relative to the project root)
# CHUNKS_PATH=data/processed/chunks.jsonl
# INDEX_DIR=index
# Minimum best reranker score (0-1) to call the LLM; below it Degbot refuses.
# Provisional (int8 reranker: off-topic question 0.0003, lowest answerable 0.23);
# to be tuned on the evaluation set.
REFUSAL_THRESHOLD=0.1

# --- Ingestion ---
# Sent with every request. Add a contact URL or e-mail if you crawl at scale.
INGEST_USER_AGENT="DegbotIngest/0.1 (non-commercial student project; bilingual RAG assistant)"
# Minimum seconds between two requests to the same host (>= 1; robots.txt Crawl-delay wins if larger)
INGEST_REQUEST_DELAY=1.0
INGEST_TIMEOUT=30
# Chunking: max tokens per chunk (multilingual-e5 tokenizer, incl. the title prefix) and overlap share
CHUNK_TOKENS=350
CHUNK_OVERLAP=0.15
# Merge sibling sections smaller than this many tokens (default CHUNK_TOKENS/4; 0 = off)
# CHUNK_MIN_SECTION_TOKENS=87
